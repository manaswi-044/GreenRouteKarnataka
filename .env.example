# Add at least one provider key to enable AI-generated day narratives and
# natural-language replanning. Keep this file local and never commit real keys.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

